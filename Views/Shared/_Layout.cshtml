
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLTKB</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f3f5f9;
            color: #263445;
        }

        .topbar {
            height: 68px;
            background: #2875bb;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 25px;
            box-shadow: 0 2px 8px #00000018;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 13px;
            font-size: 20px;
            font-weight: bold;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: white;
            color: #2875bb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .brand small {
            display: block;
            font-size: 11px;
            font-weight: normal;
            margin-top: 4px;
            letter-spacing: 1px;
        }

        .topbar-right {
            font-size: 14px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
        }

        .auth-link {
            display: inline-block;
            padding: 10px 16px;
            border: 1px solid white;
            border-radius: 6px;
            color: white;
            text-decoration: none;
            transition: 0.2s;
        }

            .auth-link:hover {
                background: white;
                color: #2875bb;
            }

        .register-link {
            background: white;
            color: #2875bb;
            font-weight: bold;
        }

            .register-link:hover {
                background: #e8f2ff;
            }

        .main-layout {
            display: flex;
            min-height: calc(100vh - 68px);
        }

        .sidebar {
            width: 245px;
            flex-shrink: 0;
            background: #202832;
            color: #d8e0e9;
            padding: 20px 12px;
        }

        .menu-title {
            color: #7dbdff;
            font-size: 12px;
            font-weight: bold;
            padding: 10px 12px 18px;
            letter-spacing: 0.5px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px 14px;
            margin-bottom: 5px;
            border-radius: 6px;
            color: #d8e0e9;
            text-decoration: none;
            font-size: 14px;
            transition: 0.2s;
        }

        .menu-item:hover {
            background: #344252;
            color: white;
        }

        .menu-item.active {
            background: #2875bb;
            color: white;
            font-weight: bold;
        }

        .menu-icon {
            width: 20px;
            text-align: center;
            font-size: 17px;
        }

        .content {
            flex: 1;
            min-width: 0;
            padding: 28px;
        }

        .page-heading {
            margin-bottom: 24px;
        }

        .page-heading h1 {
            font-size: 25px;
            margin: 0 0 8px;
            color: #263e59;
        }

        .page-heading p {
            margin: 0;
            color: #788596;
            font-size: 14px;
        }

        .footer {
            padding: 18px 0 0;
            color: #8a95a3;
            font-size: 12px;
            text-align: center;
        }

        @@media (max-width: 760px) {
            .sidebar {
                width: 72px;
                padding: 15px 7px;
            }

            .menu-title {
                display: none;
            }

            .menu-item {
                justify-content: center;
                padding: 14px 5px;
                font-size: 0;
            }

            .menu-icon {
                font-size: 19px;
            }

            .content {
                padding: 18px 12px;
            }

            .brand {
                font-size: 15px;
            }

            .topbar {
                padding: 0 12px;
            }

            .topbar-right {
                font-size: 12px;
            }
        }
    </style>
</head>

<body>
    <header class="topbar">
        <div class="brand">
            <div class="brand-icon">TKB</div>
            <div>
                HỆ THỐNG QLTKB
                <small>QUẢN LÝ THỜI KHÓA BIỂU</small>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="text-white me-2">
                    Xin chào, @(User.Identity.Name ?? "Người dùng")
                </span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light">
                        Đăng xuất
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="auth-link">
                    Đăng nhập
                </a>


                <a asp-controller="Account"
                   asp-action="Register"
                   class="auth-link register-link">
                    Đăng ký
                </a>
            }
        </div>
    </header>

    <div class="main-layout">
        <aside class="sidebar">
            <div class="menu-title">MENU CHỨC NĂNG</div>

            <a href="/" class="menu-item active">
               
                Trang chủ
            </a>

            <a href="#" class="menu-item ">
                
                Quản lý tài khoản
            </a>

            <a href="#" class="menu-item">
               
                Quản lý học phần
            </a>

            <a href="#" class="menu-item">
                
                Quản lý giảng viên
            </a>

            <a href="#" class="menu-item">
                
                Quản lý phòng học
            </a>

            <a href="#" class="menu-item">
               
                Quản lý học kỳ
            </a>

            <a href="#" class="menu-item">
                
                Lớp học phần
            </a>

            <a href="#" class="menu-item">
                
                Thời khóa biểu
            </a>

            <a href="#" class="menu-item">
                
                Xuất Excel
            </a>
        </aside>

        <main class="content">
            @RenderBody()

            <div class="footer">
                Hệ thống quản lý thời khóa biểu · QLTKB
            </div>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
