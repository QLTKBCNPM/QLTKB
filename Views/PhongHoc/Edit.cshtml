@model QLTKB.Models.PhongHoc

@{
    ViewData["Title"] = "Sửa phòng học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4>Sửa thông tin phòng học</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.PhongHocID" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="PhongHocID" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MaPhong" class="form-label">
                        Mã phòng
                    </label>
                    <input asp-for="MaPhong" class="form-control" />
                    <span asp-validation-for="MaPhong"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TenPhong" class="form-label">
                        Tên phòng
                    </label>
                    <input asp-for="TenPhong" class="form-control" />
                    <span asp-validation-for="TenPhong"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ToaNha" class="form-label">
                        Tòa nhà
                    </label>
                    <input asp-for="ToaNha" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="SucChua" class="form-label">
                        Sức chứa
                    </label>
                    <input asp-for="SucChua" type="number"
                           class="form-control" />
                    <span asp-validation-for="SucChua"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LoaiPhong" class="form-label">
                        Loại phòng
                    </label>
                    <input asp-for="LoaiPhong" class="form-control" />
                </div>

                <div class="form-check mb-3">
                    <input asp-for="TrangThai"
                           class="form-check-input" />
                    <label asp-for="TrangThai" class="form-check-label">
                        Đang hoạt động
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">
                    Cập nhật
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
