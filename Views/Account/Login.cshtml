@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - QLTKB</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: #f1f5fa;
            font-family: Arial, sans-serif;
        }

        .login-box {
            width: 100%;
            max-width: 420px;
            padding: 35px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 25px #00000012;
        }

        h2 {
            text-align: center;
            color: #2875bb;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: #778395;
            margin-bottom: 28px;
            font-size: 14px;
        }

        label {
            display: block;
            margin: 16px 0 7px;
            font-size: 14px;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #d5dce5;
            border-radius: 6px;
            font-size: 14px;
        }

        .submit-btn {
            width: 100%;
            margin-top: 24px;
            padding: 13px;
            border: none;
            border-radius: 6px;
            background: #2875bb;
            color: white;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
        }

            .submit-btn:hover {
                background: #1d609c;
            }

        .links {
            margin-top: 20px;
            text-align: center;
            font-size: 14px;
            line-height: 2;
        }

        a {
            color: #2875bb;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="login-box">
        <h2>HỆ THỐNG QLTKB</h2>
        <p class="subtitle">Đăng nhập tài khoản của bạn</p>

        <form asp-controller="Account" asp-action="Login" method="post">
            @if (ViewBag.Error != null)
            {
                <p style="color:red; text-align:center;">
                    @ViewBag.Error
                </p>
            }
            <label for="username">Tên đăng nhập</label>
            <input id="username"
                   name="username"
                   type="text"
                   placeholder="Nhập tên đăng nhập"
                   autocomplete="username"
                   required />

            <label for="password">Mật khẩu</label>
            <input id="password"
                   name="password"
                   type="password"
                   placeholder="Nhập mật khẩu"
                   autocomplete="current-password"
                   required />

            <button class="submit-btn" type="submit">
                Đăng nhập
            </button>
        </form>

        <div class="links">
            Chưa có tài khoản?
            <a asp-controller="Account" asp-action="Register">
                Đăng ký
            </a>
            <br />
            <a asp-controller="Home" asp-action="Index">
                Quay lại trang chủ
            </a>
        </div>
    </div>
</body>
</html>

