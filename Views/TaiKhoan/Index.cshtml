@model IEnumerable<QLTKB.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .account-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .account-header h1 {
            font-size: 25px;
            color: #263e59;
            margin: 0 0 8px;
        }

        .account-header p {
            color: #788596;
            font-size: 14px;
            margin: 0;
        }

    .account-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 10px #0000000d;
    }

        .account-table th {
            background: #2875bb;
            color: white;
            padding: 14px 12px;
            text-align: left;
            font-size: 14px;
        }

        .account-table td {
            padding: 13px 12px;
            border-bottom: 1px solid #e8edf3;
            font-size: 14px;
        }

        .account-table tr:hover {
            background: #f5f9fd;
        }

    .status-active {
        color: #16834b;
        font-weight: bold;
    }

    .status-inactive {
        color: #d33b3b;
        font-weight: bold;
    }

    .empty-message {
        text-align: center;
        padding: 30px;
        color: #788596;
    }

    .account-count {
        margin-bottom: 15px;
        color: #66768a;
        font-size: 14px;
    }
</style>

<div class="account-header">
    <div>
        <h1>Quản lý tài khoản</h1>
        <p>Danh sách tài khoản trong hệ thống QLTKB</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Thêm tài khoản
    </a>
</div>

<div class="account-count">
    Tổng số tài khoản: <strong>@Model.Count()</strong>
</div>

<table class="account-table">
    <thead>
        <tr>
            <th>Mã tài khoản</th>
            <th>Họ và tên</th>
            <th>Tên đăng nhập</th>
            <th>Email</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th>Ngày tạo</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    
    <tbody>
        @if (Model.Any())
        {
            @foreach (var tk in Model)
            {
                <tr>
                    <td>@tk.TaiKhoanID</td>
                    <td>@tk.HoTen</td>
                    <td>@tk.TenDangNhap</td>
                    <td>@tk.Email</td>
                    <td>@(tk.VaiTro?.TenVaiTro ?? "Chưa xác định")</td>
                    <td>
                        @if (tk.TrangThai)
                        {
                            <span class="status-active">Hoạt động</span>
                        }
                        else
                        {
                            <span class="status-inactive">Đã khóa</span>
                        }
                    </td>
                    <td>@tk.NgayTao.ToString("dd/MM/yyyy")</td>
                    <td>
    <a asp-action="Edit" asp-route-id="@tk.TaiKhoanID"
       class="btn btn-sm btn-warning">
        Sửa
    </a>

    @if (tk.TrangThai)
    {
        <a asp-action="Delete" asp-route-id="@tk.TaiKhoanID"
           class="btn btn-sm btn-danger">
            Xóa
        </a>
    }
</td>
                </tr>
              
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="empty-message">
                    Chưa có tài khoản nào trong hệ thống.
                </td>
            </tr>
        }
    </tbody>
</table>

