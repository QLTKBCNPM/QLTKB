@model QLTKB.Models.TaiKhoan

@{
    ViewData["Title"] = "Sửa tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .account-form-card {
        max-width: 750px;
        margin: 25px auto;
        padding: 30px 35px;
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    }

    .form-title {
        color: #263e59;
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-description {
        color: #8491a2;
        margin-bottom: 25px;
        font-size: 14px;
    }

    .form-group-custom {
        margin-bottom: 20px;
    }

        .form-group-custom label {
            display: block;
            font-weight: 600;
            color: #34445a;
            margin-bottom: 8px;
            font-size: 14px;
        }

    .form-control-custom {
        width: 100%;
        height: 44px;
        padding: 10px 13px;
        border: 1px solid #dce3ec;
        border-radius: 7px;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        background: white;
        transition: 0.2s;
    }

        .form-control-custom:focus {
            border-color: #2875bb;
            box-shadow: 0 0 0 3px rgba(40,117,187,0.12);
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
    }

    .btn-custom {
        padding: 10px 20px;
        border: none;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-save {
        background: #2875bb;
        color: white;
    }

        .btn-save:hover {
            background: #1d5e99;
            color: white;
        }

    .btn-back {
        background: #edf1f5;
        color: #526174;
    }

        .btn-back:hover {
            background: #dfe5ec;
            color: #34445a;
        }

    .form-error {
        padding: 11px 14px;
        background: #fff0f0;
        color: #c0392b;
        border-radius: 7px;
        margin-bottom: 20px;
    }
</style>

<div class="account-form-card">
    <h2 class="form-title">Chỉnh sửa tài khoản</h2>
    <p class="form-description">
        Cập nhật thông tin và quyền sử dụng tài khoản.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="form-error">@ViewBag.Error</div>
    }

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="TaiKhoanID"
               value="@Model.TaiKhoanID" />

        <div class="form-group-custom">
            <label>Mã tài khoản</label>
            <input value="@Model.TaiKhoanID"
                   class="form-control-custom" disabled />
        </div>

        <div class="form-group-custom">
            <label>Họ và tên</label>
            <input name="HoTen" value="@Model.HoTen"
                   class="form-control-custom" required />
        </div>

        <div class="form-group-custom">
            <label>Tên đăng nhập</label>
            <input name="TenDangNhap" value="@Model.TenDangNhap"
                   class="form-control-custom" required />
        </div>

        <div class="form-group-custom">
            <label>Email</label>
            <input name="Email" type="email" value="@Model.Email"
                   class="form-control-custom" required />
        </div>

        <div class="form-group-custom">
            <label>Vai trò</label>
            <select name="VaiTroID" asp-items="ViewBag.VaiTroID"
                    class="form-control-custom" required>
                <option value="">-- Chọn vai trò --</option>
            </select>
        </div>

        <div class="form-group-custom">
            <label>Trạng thái tài khoản</label>
            <select name="TrangThai" class="form-control-custom">
                <option value="true" selected="@(Model.TrangThai)">
                    Hoạt động
                </option>
                <option value="false" selected="@(!Model.TrangThai)">
                    Đã khóa
                </option>
            </select>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-custom btn-back">
                Quay lại
            </a>

            <button type="submit" class="btn-custom btn-save">
                Lưu thay đổi
            </button>
        </div>
    </form>
</div>
