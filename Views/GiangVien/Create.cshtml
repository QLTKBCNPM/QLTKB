@{
    ViewData["Title"] = "Thêm giảng viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="background:white; padding:25px; border-radius:12px;
    box-shadow:0 2px 10px #00000010; max-width:850px; margin:auto;">

    <h2>Thêm giảng viên</h2>
    <p style="color:#7b8794;">Nhập thông tin tài khoản và hồ sơ giảng viên.</p>

    @if (ViewBag.Error != null)
    {
        <div style="color:#b42318; margin-bottom:15px;">
            @ViewBag.Error
        </div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <h4>Thông tin tài khoản</h4>

        <div class="mb-3">
            <label>Họ và tên *</label>
            <input name="fullname" class="form-control" required />
        </div>

        <div class="mb-3">
            <label>Tên đăng nhập *</label>
            <input name="username" class="form-control" required />
        </div>

        <div class="mb-3">
            <label>Email *</label>
            <input name="email" type="email" class="form-control" required />
        </div>

        <div class="mb-3">
            <label>Mật khẩu *</label>
            <input name="password" type="password" class="form-control" required />
        </div>

        <hr />

        <h4>Thông tin hồ sơ giảng viên</h4>

        <div class="mb-3">
            <label>Mã giảng viên *</label>
            <input name="maGiangVien" class="form-control" required />
        </div>

        <div class="mb-3">
            <label>Khoa</label>
            <input name="khoa" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Bộ môn</label>
            <input name="boMon" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Học vị</label>
            <input name="hocVi" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Số điện thoại</label>
            <input name="soDienThoai" class="form-control" />
        </div>

        <div style="display:flex; gap:10px; margin-top:20px;">
            <button type="submit" class="btn btn-primary">
                Lưu giảng viên
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Quay lại
            </a>
        </div>
    </form>
</div>

